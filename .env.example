# Copiez ce fichier sous le nom .env (dans le meme dossier que START-APP.bat)
# puis remplissez les valeurs. Sans fichier .env l'application demarre quand
# meme sur son propre fichier SQLite, en mode developpement.
#
# En mode production (NODE_ENV=production) l'application REFUSE de demarrer
# si JWT_SECRET est faible, si le mot de passe admin est celui de la demo,
# ou si une mention legale obligatoire est vide. Voir DEPLOY.md.

# --- Mode ---------------------------------------------------------------
# development (defaut) ou production.
# NODE_ENV=production

# --- Reseau -------------------------------------------------------------
# PORT=3000
# HOST=127.0.0.1
# Derriere un reverse proxy (Caddy, Nginx) : met TRUST_PROXY=true pour que
# les adresses IP des journaux soient les vraies adresses des clients.
# TRUST_PROXY=true
# Origine autorisee du navigateur. Obligatoire en production.
# CORS_ORIGIN=https://marhba.ma

# --- Securite -----------------------------------------------------------
# Cle de signature des jetons. 32 caracteres aleatoires minimum.
# Generer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=collez-ici-une-longue-chaine-aleatoire
# TOKEN_TTL_DAYS=7
# Blocage des tentatives de connexion repetees, par identifiant et par IP.
# LOGIN_MAX_ATTEMPTS=10
# LOGIN_WINDOW_MINUTES=15

# --- Premier compte administrateur -------------------------------------
# Lu uniquement a la toute premiere creation de la base.
# ADMIN_NAME=Votre nom
# ADMIN_EMAIL=vous@votredomaine.ma
# ADMIN_PHONE=+2126XXXXXXXX
# ADMIN_PASSWORD=un-mot-de-passe-long-et-unique

# --- Codes de verification (OTP) ---------------------------------------
# true  : inscription et reinitialisation exigent un code (defaut).
# false : seulement pour des tests locaux.
# OTP_REQUIRED=true
# Console pilote : affiche les codes dans la fenetre du serveur et dans le
# panneau admin. Active en developpement, desactivee en production.
# OTP_CONSOLE=false

# --- Passerelle SMS -----------------------------------------------------
# infobip | twilio | generic_http | console
# console : les codes sont imprimes dans la fenetre du serveur (developpement).
# En production, console et une valeur vide sont REFUSES au demarrage.
# SMS_PROVIDER=generic_http
# Identifiant d'expediteur affiche sur le telephone du client (ou numero Twilio).
# SMS_SENDER_ID=Marhba
#
# infobip : l'URL de base est propre a votre compte (visible dans le portail).
# SMS_API_URL=https://xxxxx.api.infobip.com
# SMS_API_KEY=votre-cle-infobip
#
# twilio :
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=votre-jeton-twilio
# SMS_SENDER_ID=+212600000000
#
# generic_http : POST JSON {to, text, sender} avec Authorization: Bearer
# SMS_API_URL=https://api.votre-agregateur.ma/sms/send
# SMS_API_KEY=votre-cle

# --- Alerte nouvelle commande ------------------------------------------
# URL publique de l'application, utilisee dans les messages envoyes a
# l'exploitant du restaurant.
# PUBLIC_URL=https://marhba.ma
#
# Webhook appele a chaque nouvelle commande (POST JSON).
# Convient a un relais WhatsApp Business, a n8n, a Make ou a votre script.
# Le texte de la consigne allergie n'est jamais transmis, seulement le fait
# qu'il y en a une.
# ORDER_WEBHOOK_URL=https://votre-relais.ma/marhba
# Secret partage, envoye dans l'en-tete X-Marhba-Secret.
# ORDER_WEBHOOK_SECRET=une-chaine-aleatoire
#
# true : envoie aussi un SMS au proprietaire du restaurant a chaque commande.
# Demande une passerelle SMS configuree ci-dessus (pas console).
# Attention au cout : un SMS par commande.
# ORDER_ALERT_SMS=false

# --- Donnees de demonstration ------------------------------------------
# true : cree les 10 restaurants de demonstration et leurs menus.
# Ne jamais mettre true sur le serveur reel.
# SEED_DEMO_DATA=true

# --- Base de donnees ----------------------------------------------------
# Par defaut : data/app.db a cote de START-APP.bat.
# DB_PATH=D:\marhba\app.db
# Pour utiliser PostgreSQL a la place de SQLite (PostgreSQL doit deja
# tourner sur la machine) :
# DATABASE_URL=postgres://postgres:motdepasse@localhost:5432/marhba

# --- Surveillance des erreurs (Sentry, facultatif) ---------------------
# Colle le DSN de ton projet Sentry. Seules les erreurs sont envoyees.
# Les numeros de telephone et les adresses sont remplaces par une empreinte
# avant l'envoi, et aucun mot de passe ni jeton n'est transmis.
# SENTRY_DSN=https://cle@oXXXX.ingest.sentry.io/XXXX
# Nom du serveur dans Sentry, si tu en as plusieurs.
# SENTRY_SERVER_NAME=marhba-prod
# Version affichee dans Sentry, utile pour savoir quelle mise a jour a casse.
# APP_VERSION=2026-11-03

# --- Journaux -----------------------------------------------------------
# debug, info (defaut), warn ou error.
# LOG_LEVEL=info

# --- Mentions legales obligatoires en production ------------------------
# Ces valeurs alimentent les CGV, la politique de confidentialite, la page
# contact et les mentions legales, en francais et en arabe.
# Elles peuvent aussi etre remplies dans server/config/business.js.
# N'inventez aucune valeur : RC, ICE et forme juridique viennent de vos
# documents officiels. Voir la section 2 du README.
# BUSINESS_NAME=
# LEGAL_FORM=
# RC_NUMBER=
# ICE_NUMBER=
# BUSINESS_ADDRESS=
# BUSINESS_CITY=
# BUSINESS_PHONE=
# BUSINESS_EMAIL=
# RESPONSIBLE_PERSON=
# Facultatif : numero de declaration CNDP une fois obtenu.
# CNDP_DECLARATION=

# --- Sauvegarde hors site (S3, R2, B2) ---------------------------------
# Une sauvegarde sur le meme disque que la base n'en est pas une : le disque
# qui perd la base perd aussi la copie. Avec ces cinq valeurs, chaque
# sauvegarde quotidienne est chiffree sur cette machine puis envoyee dans un
# bucket compatible S3. Les photos des plats partent aussi, une seule fois
# chacune.
#
# Tout ou rien : en production, une configuration a moitie remplie empeche le
# demarrage, parce que le cas dangereux est celui ou deux variables sont
# remplies, rien n'est signale, et vous croyez que les copies sortent.
# BACKUP_S3_ENDPOINT=https://votrecompte.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=marhba-sauvegardes
# BACKUP_S3_KEY=
# BACKUP_S3_SECRET=
# Facultatif : region (defaut auto) et dossier dans le bucket (defaut marhba).
# BACKUP_S3_REGION=auto
# BACKUP_S3_PREFIX=marhba
#
# Phrase de chiffrement des archives. ATTENTION : gardez-la ailleurs que sur
# ce serveur. Les archives contiennent les noms, telephones et adresses de vos
# clients, donc elles sont chiffrees avant de partir ; la contrepartie est
# qu'une cle perdue rend les sauvegardes illisibles, et personne ne peut les
# recuperer pour vous.
# BACKUP_ENCRYPTION_KEY=
